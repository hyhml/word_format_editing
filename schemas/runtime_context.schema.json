{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhml/word_format_editing/schemas/runtime_context.schema.json",
  "title": "Format Runtime Context Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_fingerprint", "values"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document.degree_type": {"$ref": "#/$defs/degreeTypeResolution"}
      }
    }
  },
  "$defs": {
    "resolutionBase": {
      "type": "object",
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "degreeTypeResolution": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/resolutionBase"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value", "confidence", "evidence_ids", "reason"],
              "properties": {
                "status": {"const": "resolved"},
                "value": {"enum": ["doctoral", "master", "professional_master"]},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "evidence_ids": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "minItems": 1,
                  "uniqueItems": true
                },
                "reason": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolutionBase"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value", "confidence", "evidence_ids", "reason"],
              "properties": {
                "status": {"const": "unknown"},
                "value": {"type": "null"},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "evidence_ids": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                },
                "reason": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          ]
        }
      ]
    }
  }
}
