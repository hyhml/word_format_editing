{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhml/word_format_editing/schemas/format_spec.schema.json",
  "title": "Canonical Word Format Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "policies", "document", "targets", "selectors", "recognition"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "institution", "document_type", "year", "description", "sources"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "institution": {"type": ["string", "null"]},
        "document_type": {"type": ["string", "null"]},
        "year": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "type"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "type": {"enum": ["txt", "md", "json", "doc", "docx", "pdf"]},
              "warnings": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unspecified_property_action", "selector_priority", "conflict_action", "unknown_condition_action", "multiple_condition_match_action"],
      "properties": {
        "unspecified_property_action": {"const": "preserve"},
        "conflict_action": {"const": "preserve"},
        "unknown_condition_action": {"const": "preserve"},
        "multiple_condition_match_action": {"const": "preserve"},
        "selector_priority": {
          "type": "array",
          "const": ["explicit_location", "structure", "style", "regex", "body_fallback"]
        }
      }
    },
    "document": {"$ref": "#/$defs/targetRule"},
    "targets": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/targetRule"}
    },
    "selectors": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/selector"}
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "compiler", "requires_review"],
      "properties": {
        "status": {"enum": ["success", "warn", "blocked"]},
        "compiler": {"type": "string", "minLength": 1},
        "requires_review": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "targetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties"],
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/propertyAction"}
        }
      }
    },
    "propertyAction": {
      "oneOf": [
        {"$ref": "#/$defs/setAction"},
        {"$ref": "#/$defs/preserveAction"},
        {"$ref": "#/$defs/removeAction"},
        {"$ref": "#/$defs/conditionalAction"}
      ]
    },
    "setAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "value", "evidence_ids"],
      "properties": {
        "action": {"const": "set"},
        "value": {},
        "unit": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "method": {"enum": ["deterministic", "ai", "derived", "user_confirmed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "preserveAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": {"const": "preserve"},
        "reason": {
          "enum": ["not_specified", "not_recognized", "unresolved_value", "unresolved_conflict", "unresolved_dependency", "unsupported", "explicitly_preserve"]
        },
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "removeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "evidence_ids"],
      "properties": {
        "action": {"const": "remove"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "method": {"enum": ["deterministic", "ai", "user_confirmed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "conditionalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "cases", "multiple_match_action", "fallback"],
      "properties": {
        "action": {"const": "conditional"},
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/conditionalCase"}
        },
        "multiple_match_action": {"const": "preserve"},
        "fallback": {
          "oneOf": [
            {"$ref": "#/$defs/setAction"},
            {"$ref": "#/$defs/preserveAction"},
            {"$ref": "#/$defs/removeAction"}
          ]
        }
      }
    },
    "conditionalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "value", "evidence_ids"],
      "properties": {
        "when": {"$ref": "#/$defs/condition"},
        "value": {},
        "unit": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "method": {"enum": ["deterministic", "ai", "derived", "user_confirmed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "operator"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "operator": {"enum": ["equals", "not_equals", "in", "not_in", "exists"]},
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {"not": {"$ref": "#/$defs/condition"}}
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explicit_locations": {"type": "array", "items": {"type": "string"}},
        "structure_type": {"type": "string"},
        "structure_level": {"type": "integer", "minimum": 1, "maximum": 9},
        "style_names": {"type": "array", "items": {"type": "string"}},
        "fallback_regex": {"type": "array", "items": {"type": "string"}},
        "match_scope": {"enum": ["block", "text_span"]},
        "within_target": {"type": "string"},
        "capture_group": {"type": "integer", "minimum": 0, "maximum": 99},
        "exclude_targets": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
